# Use a random alphanumeric DB password (URL-safe).
POSTGRES_PASSWORD=replace-with-random-password
PORT=8080
WEBHOOK_PORT=8098
BASE_URL=http://localhost:8080
# Generate with: ADMIN_PASSWORD='...' go run ./cmd/setup hash-password (inside backend)
# Keep single quotes: Docker Compose must not interpolate the bcrypt dollar signs.
ADMIN_PASSWORD_HASH=''
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_WEBHOOK_SECRET=
LAVA_API_KEY=
LAVA_WEBHOOK_SECRET=
LAVA_OFFER_ID=
LAVA_FOREIGN_CURRENCY=USD
PLAN_NAME=Подписка в клуб
PLAN_PRICE_LABEL=Согласно выбранному тарифу на странице оплаты
PLAN_PERIOD_LABEL=Выбранный период
DISPLAY_TIMEZONE=Asia/Yekaterinburg
